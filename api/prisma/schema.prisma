generator client {
  provider      = "prisma-client-js"
  // "rhel-openssl-3.0.x" matches the Amazon Linux 2023 runtime used by AWS Lambda nodejs20.x
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Tabla fuente de verdad de las piezas (incluye foto en base64).
model Producto {
  id        String   @id @default(uuid()) @db.Char(36)
  idLegacy  Int?     @map("id_legacy")
  codigo    String?  @db.VarChar(20)
  categoria String?  @db.VarChar(100)
  marca     String?  @db.VarChar(100)
  modelo    String?  @db.VarChar(100)
  anio      String?  @db.VarChar(20)
  lado      String?  @db.VarChar(10)
  condicion String?  @db.VarChar(20)
  precio    Decimal? @db.Decimal(10, 2)
  vendido   Boolean  @default(false)
  cantidad  Int?
  detalle   String?  @db.Text
  posicion  String?  @db.VarChar(50)
  bgc       String?  @db.VarChar(20)
  fit       String?  @db.VarChar(20)
  alias     String?  @db.VarChar(150)
  foto      String?  @db.LongText
  createdAt DateTime @default(now()) @map("created_at")

  @@index([categoria])
  @@index([marca])
  @@index([vendido])
  @@map("productos")
}

/// Vista materializada (tabla real sin foto, sincronizada por triggers) usada
/// para listado y paginacion rapidos. Se crea/mantiene con sql/materialized_view.sql,
/// NO ejecutar `prisma db push`/`migrate` sobre este modelo para no perder los triggers.
model ProductoMv {
  id        String   @id @db.Char(36)
  idLegacy  Int?     @map("id_legacy")
  codigo    String?  @db.VarChar(20)
  categoria String?  @db.VarChar(100)
  marca     String?  @db.VarChar(100)
  modelo    String?  @db.VarChar(100)
  anio      String?  @db.VarChar(20)
  lado      String?  @db.VarChar(10)
  condicion String?  @db.VarChar(20)
  precio    Decimal? @db.Decimal(10, 2)
  vendido   Boolean  @default(false)
  cantidad  Int?
  posicion  String?  @db.VarChar(50)
  alias     String?  @db.VarChar(150)
  tieneFoto Boolean  @default(false) @map("tiene_foto")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@index([categoria])
  @@index([marca])
  @@index([modelo])
  @@index([anio])
  @@index([lado])
  @@index([codigo])
  @@index([vendido])
  @@map("productos_mv")
}
